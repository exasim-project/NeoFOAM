        <argsstring>(NeoN::Dictionary &amp;dict, const std::string &amp;sourceKey, const std::string &amp;targetKey, const std::string &amp;patchName, const Foam::fvPatch *patch)</argsstring>
        <name>insertUniformValue</name>
        <qualifiedname>NeoFOAM::detail::insertUniformValue</qualifiedname>
        <param>
          <type>NeoN::Dictionary &amp;</type>
          <declname>dict</declname>
        </param>
        <param>
          <type>const std::string &amp;</type>
          <declname>sourceKey</declname>
