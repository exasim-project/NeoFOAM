FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // Steady SIMPLE: every equation uses the steadyState ddt (no time term).
    // NeoN's DdtOperator now supports steadyState directly, so the previous
    // Euler/BDF1 pseudo-transient workaround for ddt(k)/ddt(omega) is no longer
    // needed; turbulence stability comes from the k/omega equation
    // under-relaxation, matching the OpenFOAM simpleFoam reference.
    default         steadyState;
}

gradSchemes
{
    // NeoFOAM's GradOperator::read does an exact-key lookup with no `default`
    // fallback, so every grad(...) used by the solver/turbulence model must be
    // listed explicitly. grad(U) uses the cell-limited gradient (NeoN's
    // CellLimitedGrad, registered as "cellLimited"), matching the OpenFOAM
    // simpleFoam reference: the minmod limiter clamps the gradient so values
    // extrapolated to faces stay within the neighbour cell-value range,
    // stabilising convection on the skewed/refined DrivAre mesh.
    default         Gauss linear;
    grad(p)         Gauss linear;
    grad(U)         cellLimited Gauss linear 1;
    grad(k)         Gauss linear;
    grad(omega)     Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      bounded Gauss linearUpwindV grad(U);

    turbulence      bounded Gauss upwind;
    div(phi,k)      $turbulence;
    div(phi,omega)  $turbulence;

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;

    // NeoN's fused div+laplacian operator (imp::div - imp::laplacian for U/k/omega) looks up these
    // scheme keys by EXACT name with no `default` fallback, so they must be spelled out explicitly.
    // Values are identical to `default` (Gauss linear corrected) -> numerically a no-op vs. the
    // §4.15 baseline; this only lets the current NeoN HEAD's operator find its scheme entry.
    laplacian(nuEff,U)          Gauss linear corrected;
    laplacian(DkEff,k)          Gauss linear corrected;
    laplacian(DomegaEff,omega)  Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}

