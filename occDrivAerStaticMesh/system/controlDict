// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

#include          "include/caseDefinition"

application     neoSimpleFoam;

executor        GPU;

allocator       Umpire;

memPoolSize     120;

libs            ( "libturbulenceModels.so" );

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         4000;

deltaT          1;

writeControl    timeStep;

writeInterval   100000;

purgeWrite      2;

writeFormat     binary;

writePrecision  16;

writeCompression off;

timeFormat      general;

timePrecision   7;

runTimeModifiable yes;

adjustableRunTime no;


