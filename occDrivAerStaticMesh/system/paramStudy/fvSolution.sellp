FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// PARAM STUDY sellp: p = Ginkgo CG (Jacobi/Schwarz) with localMatrixFormat=Sellp
//                    U,k,omega = PBiCGStab/diagonal
// SELL-P only applies to the plain Ginkgo CG solver (not the multigrid sweep in
// param-study-mg.sh): the rank-local matrix is converted from Csr to SELL-P before
// the distributed SpMV. p-cg.json carries the CG solver/preconditioner/stop; the
// p-block keys below select Sellp and supply the L1-scaled residual tolerances.

solvers
{
    p
    {
        configFile        system/gko/p-cg.json;
        localMatrixFormat Sellp;
        l1ScaledResidual  true;
        tolerance         1e-7;
        relTol            0.01;
    }

    Phi
    {
        $p;
    }

    U
    {
        solver           PBiCGStab;
        preconditioner   diagonal;
        tolerance        1e-8;
        relTol           0.1;
        l1ScaledResidual true;
    }

    k
    {
        solver           PBiCGStab;
        preconditioner   diagonal;
        tolerance        1e-8;
        relTol           0.1;
        l1ScaledResidual true;
    }

    omega
    {
        solver           PBiCGStab;
        preconditioner   diagonal;
        tolerance        1e-8;
        relTol           0.1;
        l1ScaledResidual true;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent yes;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        k               0.7;
        omega           0.7;
    }
}

cache
{
    grad(U);
}

// ************************************************************************* //
