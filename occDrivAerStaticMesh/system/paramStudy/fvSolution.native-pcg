FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// PARAM STUDY native-pcg: native OpenFOAM simpleFoam baseline.
//   p = PCG/diagonal, U/k/omega = PBiCGStab/diagonal.
// Run by param-study-mg.sh's "native-pcg" variant with the simpleFoam binary (not
// neoSimpleFoam). The PCG/diagonal counterpart of the GAMG native run (fvSolution.native)
// and the OpenFOAM reference for the Ginkgo CG p-solver variants.

solvers
{
    p
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-7;
        relTol          0.01;
        maxIter         2000;
    }

    Phi
    {
        $p;
    }

    U
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-8;
        relTol          0.1;
    }

    k
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-8;
        relTol          0.1;
    }

    omega
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent yes;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    equations
    {
        U               0.9;
        k               0.6;
        omega           0.6;
    }
}

cache
{
    grad(U);
}

// ************************************************************************* //
