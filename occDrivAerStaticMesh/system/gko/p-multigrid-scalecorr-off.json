                    "type": "preconditioner::Jacobi",
                    "max_block_size": 1
                }
            },
            "criteria": [
                {
                    "type": "Iteration",
                    "max_iters": 4
                }
            ]
        },
        "criteria": [
            {
                "type": "Iteration",
                "max_iters": 1
            }
        ]
    },
    "criteria": [
        {
            "type": "Iteration",
