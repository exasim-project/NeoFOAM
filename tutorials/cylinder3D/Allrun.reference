#!/bin/sh
cd "${0%/*}" || exit                                # tutorials/cylinder3D/
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

REF_CASE="$(pwd)/../cylinder3D_ref"
echo "Creating reference case in $REF_CASE"
mkdir -p "$REF_CASE"
cp -r system constant processor0 processor1 processor2 processor3 "$REF_CASE/"

# Override to short diagnostic run
foamDictionary -entry endTime       -set 5e-3 "$REF_CASE/system/controlDict"
foamDictionary -entry writeInterval -set 20   "$REF_CASE/system/controlDict"

cd "$REF_CASE"
mpirun -np 4 icoFoam -parallel > log.icoFoam 2>&1
echo "icoFoam reference run complete. Log: $REF_CASE/log.icoFoam"
