FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
    ddt(U)          Euler;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)         Gauss linear;
    grad(p)         Gauss linear;
}

divSchemes
{
    default         none;
    div(phi,U)      Gauss linear;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default             Gauss linear corrected;
    laplacian(nuEff,U)  Gauss linear corrected;
    laplacian(rAU,p)    Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
    flux(HbyA)      linear;
    interpolate(rAU) linear;
}

snGradSchemes
{
    default         corrected;
    snGrad(p)       corrected;
}


