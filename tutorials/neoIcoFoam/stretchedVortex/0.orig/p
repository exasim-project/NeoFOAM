FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    sides
    {
        type            zeroGradient;
    }

    // U is prescribed on every patch, so p is defined only up to a constant
    // and is Neumann everywhere. The level is pinned by pRefCell/pRefValue in
    // system/fvSolution; neoIcoFoam applies them via pEqn.setReference() when
    // needReference() is true.
    top
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }
}


