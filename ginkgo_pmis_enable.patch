 void transpose(std::shared_ptr<const DefaultExecutor> exec,
                const matrix::SparsityCsr<ValueType, IndexType>* orig,
                matrix::SparsityCsr<ValueType, IndexType>* trans)
-    GKO_NOT_IMPLEMENTED;
+{
+    // Upstream leaves the device sparsity-pattern transpose unimplemented
+    // (GKO_NOT_IMPLEMENTED, Ginkgo PR #2037). PMIS coarsening needs it once per level
+    // during hierarchy SETUP (not in the solve loop), so a host round-trip is correct
+    // and cheap: copy the pattern to the host, transpose (CSR -> CSC), copy back.
+    const auto num_rows = static_cast<size_type>(orig->get_size()[0]);
+    const auto num_cols = static_cast<size_type>(orig->get_size()[1]);
+    const auto nnz = orig->get_num_nonzeros();
+    auto master = exec->get_master();
+
+    std::vector<IndexType> row_ptrs(num_rows + 1);
+    std::vector<IndexType> col_idxs(nnz);
+    master->copy_from(exec, num_rows + 1, orig->get_const_row_ptrs(),
+                      row_ptrs.data());
+    master->copy_from(exec, nnz, orig->get_const_col_idxs(), col_idxs.data());
+
+    std::vector<IndexType> t_row_ptrs(num_cols + 1, IndexType{});
+    std::vector<IndexType> t_col_idxs(nnz);
+    // counting sort by column == CSR -> CSC (the transposed sparsity pattern)
+    for (size_type i = 0; i < nnz; i++) {
+        t_row_ptrs[col_idxs[i] + 1]++;
+    }
+    for (size_type i = 0; i < num_cols; i++) {
+        t_row_ptrs[i + 1] += t_row_ptrs[i];
+    }
+    std::vector<IndexType> next(t_row_ptrs.begin(), t_row_ptrs.end());
+    for (size_type row = 0; row < num_rows; row++) {
+        for (IndexType k = row_ptrs[row]; k < row_ptrs[row + 1]; k++) {
+            const auto col = static_cast<size_type>(col_idxs[k]);
+            t_col_idxs[next[col]++] = static_cast<IndexType>(row);
+        }
+    }
+
+    exec->copy_from(master, num_cols + 1, t_row_ptrs.data(),
+                    trans->get_row_ptrs());
+    exec->copy_from(master, nnz, t_col_idxs.data(), trans->get_col_idxs());
+}
 
 GKO_INSTANTIATE_FOR_EACH_VALUE_AND_INDEX_TYPE(
     GKO_DECLARE_SPARSITY_CSR_TRANSPOSE_KERNEL);
