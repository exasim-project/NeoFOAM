{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// CrossPowerLaw: nu = (nu0 - nuInf)/(1 + (m*strainRate)^n) + nuInf.
// No native NeoFOAM viscosity model is registered for it, so the solver's
// selection resolves to the OpenFOAM fallback adapter. The ``CrossPowerLawCoeffs``
// block is patched in by the test (CROSS_POWER_LAW in
// test_non_newtonian_fallback_nu.py), so the coefficients live next to the expected
// nu they were chosen to keep short exact decimals.

transportModel  CrossPowerLaw;


