5
(
    fixedWalls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          9;
        startFace       13;
    }
    inlet
    {
        type            patch;
        nFaces          4;
        startFace       22;
    }
    outlet
    {
        type            patch;
        nFaces          1;
        startFace       26;
    }
    procBoundary1to0
    {
        type            processor;
        inGroups        1(processor);
        nFaces          5;
        startFace       27;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    0;
    }
    procBoundary1to2
    {
        type            processor;
        inGroups        1(processor);
        nFaces          9;
        startFace       32;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    2;
    }
