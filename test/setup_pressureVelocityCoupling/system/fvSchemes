FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "simulationParameters"

ddtSchemes
{
    default         none;
    ddt(U)          Euler;
    ddt(rho,U)      Euler;
    ddt(rho,T)      Euler;
    ddt(nuTilda)    Euler;
}

gradSchemes
{
    default         none;
    grad(p)         $GRADSCHEME;
    grad(T)         $GRADSCHEME;
    grad(U)         $GRADSCHEME;
    grad(nuTilda)   $GRADSCHEME;
    limited         cellLimited Gauss linear 1;
}

divSchemes
{
    default         none;
    div(phi,U)      $DIVSCHEME;
    // read only by boundedDivScheme.cpp, via a flux field named boundedPhi
    div(boundedPhi,U)             bounded Gauss upwind;
    div(phi,nuTilda)              Gauss linear;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default                       none;
    laplacian(nu,U)               $LAPSCHEME;
    laplacian(rAUf,p)             $LAPSCHEME;
    laplacian(Gamma,p)            $LAPSCHEME;
    laplacian(nuEff,U)             $LAPSCHEME;
    laplacian(nuEff,nuTilda)       $LAPSCHEME;
    laplacian(DnuTildaEff,nuTilda)  $LAPSCHEME;
}

interpolationSchemes
{
    default         linear;
    flux(U)         linear;
    flux(HbyA)      linear;
}

snGradSchemes
{
    default         uncorrected;
}

fluxRequired
{
    p;
}

wallDist
{
    method          meshWave;
}


