FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// placeholder — the tests seed the values (case_setup: p_rgh[:] = ...)
internalField   uniform 0;

boundaryField
{
    walls
    {
        // constrainPressure sets the gradient that closes the walls to the flux
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

