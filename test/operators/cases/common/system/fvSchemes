FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         none;
    grad(T)         Gauss linear;
    grad(U)         Gauss linear;
}

divSchemes
{
    default         none;
    div(phi,T)      Gauss linear;
    // read only by the scheme="from fvSchemes" parity test: every other div test
    // passes its scheme explicitly. Carries the "bounded" convection prefix so
    // that test sees whether map_fv_schemes hands the prefix through untouched.
    div(phi,U)      bounded Gauss upwind;
    // named entries for the scalar-convection flux: fvc.flux(phi, T, key=...)
    // only takes a lookup key, so each div-scheme variant is staged here
    divT_linear         Gauss linear;
    divT_upwind         Gauss upwind;
    divT_linearUpwind   Gauss linearUpwind grad(T);
}

laplacianSchemes
{
    default         none;
    laplacian(Gamma,T) Gauss linear uncorrected;
    laplacian(Gamma,U) Gauss linear uncorrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         uncorrected;
}

