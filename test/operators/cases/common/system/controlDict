FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     none;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    runTime;

writeInterval   1;

writeFormat     ascii;

// 17 significant digits: the seeded fields round-trip bit-identically, so
// both backends read exactly the values the stager computed.
writePrecision  17;

timeFormat      general;

timePrecision   16;

