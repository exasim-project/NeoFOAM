FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   nonuniform List<scalar>
9
(
1
2
3
4
5
6
7
8
9
)
;

boundaryField
{
    movingWall
    {
        type            fanPressure;
        patchType       wall;
        fanCurve        tableFile;
        file            "constant/fanCurve.dat";
        direction       in;
        p0              uniform 0;
        value           uniform 0;
    }
    fixedWalls
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

