dimensions      [0 1 -1 0 0 0 0];

// Overwritten by the setup worker with a nonuniform, divergence-free velocity
// (see _parity_worker.role_setup); this uniform template just keeps the case valid.
internalField   uniform (1.0 0.6 0.35);

boundaryField
{
    ".*"
    {
        type            zeroGradient;
    }
}


