FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The k / epsilon linear solves are driven to a very tight tolerance so both
// backends converge to the (identical) matrix's true solution rather than to a
// backend-specific iterate — that is what lets the eddy viscosity match to the
// solver tolerance (~1e-10) rather than to the looser linear-solver residual.

// Explicit (non-regex) keys: NeoN's PDESolverScalar looks the field's solver up
// by a literal ``unordered_map::at(name)``, so a regex key like "(k|epsilon)"
// would resolve for pybFoam but miss on the NeoN side.
solvers
{
    k
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    kFinal
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    epsilon
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    epsilonFinal
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    nuTilda
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    nuTildaFinal
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    omega
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }

    omegaFinal
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         2000;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    1;
    nNonOrthogonalCorrectors 0;
    nCorrectors         2;
}


