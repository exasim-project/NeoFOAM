FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Flow enters through `inlet` (x = 1) and leaves through `outlet` (x = 0).
internalField   uniform (-0.5 0.1 0.0);

boundaryField
{
    fixedWalls
    {
        type            noSlip;
    }
    inlet
    {
        type            atmBoundaryLayerInletVelocity;
        flowDir         (-1 0 0);
        zDir            (0 0 1);
        Uref            0.5;
        Zref            0.5;
        z0              uniform 0.01;
        d               uniform 0;
    }
    outlet
    {
        type            zeroGradient;
    }
}

