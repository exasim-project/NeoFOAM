FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        system;
    object          fvSchemes;
}

ddtSchemes
{
    ddt(U)          Euler;
    default         Euler;
}

gradSchemes
{
    grad(U)         Gauss linear;
    grad(p)         Gauss linear;
    default         Gauss linear;
}

divSchemes
{
    div(phi,U)      Gauss linear;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
    default         none;
}

laplacianSchemes
{
    laplacian(nuEff,U) Gauss linear uncorrected;
    laplacian(rAUf,p) Gauss linear uncorrected;
    default         Gauss linear uncorrected;
    laplacian(nu,U) Gauss linear uncorrected;
    laplacian(rAUfNF,p) Gauss linear uncorrected;
}

interpolationSchemes
{
    flux(U)         linear;
    flux(HbyA)      linear;
    interpolate(rAU) linear;
    dotInterpolate(S,U_0) linear;
    default         linear;
}

snGradSchemes
{
    snGrad(p)       uncorrected;
    default         uncorrected;
}


