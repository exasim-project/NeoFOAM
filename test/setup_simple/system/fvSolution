FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    p
    {
        solver PCG;
        preconditioner diagonal;
        tolerance 1e-13;
        relTol 0.01;
        maxIter 1000;
    }
    U
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-13;
        relTol 0.1;
        maxIter 1000;
    }
}

relaxationFactors
{
    equations
    {
        U       0.7;
    }
    fields
    {
        p       0.3;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    momentumPredictor no;
    consistent      no;
    pRefCell        0;
    pRefValue       0;
}

