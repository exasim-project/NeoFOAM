FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object invalidShared;
}

config
{
    service_a
    {
        timeout 30;
        maxConnections 10;
    }

    service_b
    {
        endpoint example.com;
        poolSize -5;
    }

    service_c
    {
        enabled yes;
        bufferSize 1024;
    }
}
