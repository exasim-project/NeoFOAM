FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object shared;
}

config
{
    service_a
    {
        timeout 30;
        maxConnections 10;
    }

    service_b
    {
        endpoint example.com;
        port 8080;
        poolSize 20;
    }

    service_c
    {
        enabled yes;
        bufferSize 1024;
    }
}
