FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object nested;
}

metadata
{
    name TestApp;
    version "1.0";
    priority 5;
}

processing
{
    stage1
    {
        algorithm fast;
        threshold 0.001;
        maxIterations 100;
        batchSize 32;
    }

    stage2
    {
        algorithm accurate;
        threshold 0.0001;
        maxIterations 50;
        batchSize 16;
    }
}
