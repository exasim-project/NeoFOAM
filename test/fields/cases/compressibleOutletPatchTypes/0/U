FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 2 3);

boundaryField
{
    // sineWaveDamping's inlet/outlet velocity. Like the other flux-dependent BCs it
    // holds the internal value when read and only evaluates against a boundary
    // context; the `value` entry is not used.
    xMin
    {
        type            pressureInletOutletVelocity;
        value           uniform (4 5 6);
    }

    xMax
    {
        type            zeroGradient;
    }

    "(yMin|yMax|zMin|zMax)"
    {
        type            noSlip;
    }
}


