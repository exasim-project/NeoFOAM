FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     @CTRL_APPLICATION@;
@CTRL_EXECUTOR_LINE@
@CTRL_ALLOCATOR_LINE@
startFrom       @CTRL_START_FROM@;

startTime       0;

stopAt          endTime;

endTime         @CTRL_END_TIME@;

deltaT          @CTRL_DELTA_T@;

writeControl    @CTRL_WRITE_CONTROL@;

writeInterval   @CTRL_WRITE_INTERVAL@;

purgeWrite      0;

writeFormat     @CTRL_WRITE_FORMAT@;

writePrecision  @CTRL_WRITE_PRECISION@;

writeCompression off;

timeFormat      general;

timePrecision   @CTRL_TIME_PRECISION@;

runTimeModifiable true;
@CTRL_EXTRAS@
@CTRL_PROFILING_BLOCK@
