FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A 2-D 8 mm x 8 mm box, 40 x 40 cells (R/dx = 10 for the 2 mm droplet).
scale   0.001;

vertices
(
    (0 0 0) (8 0 0) (8 8 0) (0 8 0)
    (0 0 0.2) (8 0 0.2) (8 8 0.2) (0 8 0.2)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 40 1) simpleGrading (1 1 1)
);

boundary
(
    leftWall { type wall; faces ((0 4 7 3)); }
    rightWall { type wall; faces ((2 6 5 1)); }
    lowerWall { type wall; faces ((1 5 4 0)); }
    atmosphere { type patch; faces ((3 7 6 2)); }
    frontAndBack { type empty; faces ((0 3 2 1) (4 5 6 7)); }
);

