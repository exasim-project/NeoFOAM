FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// The stock pitzDaily relaxationFactors: a catch-all ``".*"`` in the *equations*
// block. OpenFOAM's dictionary lookup matches that regex for every field name —
// including ``p`` — but simpleFoam only ever calls fvMatrix::relax() on the
// momentum and turbulence matrices, never on the pressure equation. A backend
// that relaxes every matrix it solves turns the pressure Poisson operator into a
// Helmholtz one (diag /= 0.9) and stalls the flow; this overlay pins that it does
// not.

solvers
{
    p
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-13;
        relTol          0;
        maxIter         5000;
        l1ScaledResidual true;
    }

    U
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-13;
        relTol          0;
        maxIter         1000;
        l1ScaledResidual true;
    }

    k
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-13;
        relTol          0;
        maxIter         2000;
        l1ScaledResidual true;
    }

    epsilon
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-13;
        relTol          0;
        maxIter         2000;
        l1ScaledResidual true;
    }

    omega
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-13;
        relTol          0;
        maxIter         2000;
        l1ScaledResidual true;
    }

    nuTilda
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-13;
        relTol          0;
        maxIter         2000;
        l1ScaledResidual true;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      no;
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        ".*"            0.9;
    }
}

