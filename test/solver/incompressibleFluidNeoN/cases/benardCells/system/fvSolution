FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-12;
        relTol          0;
        maxIter         5000;
    }
    p_rghFinal
    {
        $p_rgh;
    }
    "(U|T|k|epsilon|R)"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-12;
        relTol          0;
        maxIter         5000;
    }
    "(U|T|k|epsilon|R)Final"
    {
        $U;
    }
}

PIMPLE
{
    momentumPredictor yes;

    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

relaxationFactors
{
    equations
    {
        "(U|T|k|epsilon|R)" 1;
        "(U|T|k|epsilon|R)Final" 1;
    }
}


