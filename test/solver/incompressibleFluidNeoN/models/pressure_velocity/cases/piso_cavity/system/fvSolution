FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    p
    {
        solver PCG;
        preconditioner diagonal;
        tolerance 1e-13;
        relTol 1e-13;
        maxIter 5000;
        l1ScaledResidual true;
    }
    pFinal
    {
        solver PCG;
        preconditioner diagonal;
        tolerance 1e-13;
        relTol 1e-13;
        maxIter 5000;
        l1ScaledResidual true;
    }
    U
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-13;
        relTol 1e-13;
        maxIter 1000;
        l1ScaledResidual true;
    }
    UFinal
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-13;
        relTol 1e-13;
        maxIter 1000;
        l1ScaledResidual true;
    }
}

relaxationFactors
{
    equations
    {
        U       0.7;
        UFinal  1;
    }
    fields
    {
        p       0.3;
        pFinal  1;
    }
}

PISO
{
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;
    pRefCell 0;
    pRefValue 0;
}

