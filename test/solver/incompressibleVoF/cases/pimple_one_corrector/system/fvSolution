FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// nCorrectors 1 is invalid for the PISO pressure correction (needs >= 2):
// the factory must reject it with a clear solver-level error.
PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    1;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;
}
