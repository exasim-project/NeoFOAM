FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// nCorrectors 1: a single PISO corrector, as real interFoam cases use. The
// factory must honour it (read it straight from the dict), not reject it.
PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    1;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;
}
