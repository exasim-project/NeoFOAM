FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// The base every PIMPLE-dict variant of conftest.py's PIMPLE_VARIANTS forks:
// three outer correctors, turbOnFinalIterOnly left at its native default
// (true) — interFoam/RAS/damBreakPorousBaffle's shape.
PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    3;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;
}
