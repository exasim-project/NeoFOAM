FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         none;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         none;
}

// linear interpolation is all the alpha-Courant number needs
// (fvc::interpolate(alpha1) and fvc::flux(U)).
interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         uncorrected;
}

