/*--------------------------------*- C++ -*----------------------------------*\
| NeoFOAM: dict-driven Cartesian mesh + direct-forcing cylinder                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Channel [0,2] x [0,1] x [0,0.25] (thin, periodic in z).
domain          ( ( 0 0 0 ) ( 2 1 0.25 ) );
nCell           ( 64 32 8 );
periodicity     ( false false true );

refinement
{
    maxLevel    0;
    refRatio    ( 2 2 2 );
}

// Immersed cylinder: D = 0.2, axis = z. Re = U*D/nu = 1*0.2/0.01 = 20.
eb
{
    type        cylinder;
    center      ( 0.5 0.5 0.125 );
    radius      0.1;
    axis        2;
}

// Per-face velocity BC (AMReX faces xlo/xhi/ylo/yhi; z is periodic).
boundary
{
    xlo { type fixedValue; value ( 1 0 0 ); }
    xhi { type zeroGradient; }
    ylo { type slip; }
    yhi { type slip; }
}

// ************************************************************************* //
