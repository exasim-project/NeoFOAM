FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     incompressibleFluidBlockAMR;

startTime       0;

// deltaT is a negative power of two (2^-4) so the explicit backend's f32
// dt/coeff cast is exact — isolating the jax vs cpp comparison from that
// pre-existing scaling and leaving only float64 summation-order differences.
endTime         0.25;

deltaT          0.0625;

writeControl    timeStep;

writeInterval   4;

executor        cpu;

