FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Sharp disc of alpha.water = 1: centred at (0.35, 0.5), radius 0.15
// (test/solver/test_disc_advection.py).

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    cylinderToCell
    {
        p1 (0.35 0.5 -1);
        p2 (0.35 0.5 1);
        radius 0.15;
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);


