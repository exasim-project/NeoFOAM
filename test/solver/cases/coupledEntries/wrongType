FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    outer
    {
        type            fixedValue;
        value           uniform 400;
    }
    interface
    {
        type            fixedValue;
        coupled         coupledTemperature;
        value           uniform 300;
    }
    walls
    {
        type            zeroGradient;
    }
}
