FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A small 2-D damBreak: walls on the left, right and bottom, the open atmosphere on top and
// empty front and back faces. The grading makes the linear weights differ from 1/2; the empty
// direction exercises the 2-D branch of fvc::reconstruct's tensor inverse.

scale   1;

vertices
(
    (0 0 0)
    (0.584 0 0)
    (0.584 0.584 0)
    (0 0.584 0)
    (0 0 0.0146)
    (0.584 0 0.0146)
    (0.584 0.584 0.0146)
    (0 0.584 0.0146)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (7 6 1) simpleGrading (2 0.5 1)
);

edges
(
);

boundary
(
    walls
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (2 6 5 1)
            (1 5 4 0)
        );
    }
    atmosphere
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

