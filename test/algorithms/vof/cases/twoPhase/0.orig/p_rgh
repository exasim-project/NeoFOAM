FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// damBreak's pressure conditions, as far as NeoN has them: fixedFluxPressure walls and a
// fixed-value open top (the damBreak meshes' atmosphere patch).

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    walls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    atmosphere
    {
        type            fixedValue;
        value           uniform 50;
    }
    frontAndBack
    {
        type            empty;
    }
}

