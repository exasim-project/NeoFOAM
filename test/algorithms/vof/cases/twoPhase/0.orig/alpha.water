FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The phase fraction of the two-phase mixture tests. Both patch values lie outside [0, 1],
// so the clamp of the mixture viscosity also acts on the boundary.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    walls
    {
        type            fixedValue;
        value           uniform 1.2;
    }
    atmosphere
    {
        type            fixedValue;
        value           uniform -0.1;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
