FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The workers only evaluate operators — nothing is solved. MULES reads its
// limiter controls from the solver entry of the limited field.
solvers
{
    "alpha|alphaFixed"
    {
        nLimiterIter    3;
    }
    alpha.water
    {
        cAlpha          1;
    }
}

