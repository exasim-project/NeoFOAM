FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphaFixed;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// setFields writes the sphere. The fixedValue walls make the MULES parity tests
// exercise OpenFOAM's boundary extrema widening (MULES::limiter,
// psiPf.fixesValue()): with the zeroGradient U the walls carry inflow and outflow
// of alpha = 1.
internalField   uniform 0;

boundaryField
{
    walls
    {
        type            fixedValue;
        value           uniform 1;
    }
}

