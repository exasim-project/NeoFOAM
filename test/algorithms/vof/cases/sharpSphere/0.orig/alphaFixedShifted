FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphaFixedShifted;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// setFields writes the shifted sphere: the base of mules.correct, whose difference
// from alpha gives a nonzero boundary correction flux
internalField   uniform 0;

boundaryField
{
    walls
    {
        type            fixedValue;
        value           uniform 1;
    }
}

