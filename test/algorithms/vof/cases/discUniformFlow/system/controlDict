FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     none;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.2;

deltaT          0.005;

writeControl    runTime;

writeInterval   0.1;

writeFormat     ascii;

writePrecision  17;

timeFormat      general;

timePrecision   6;

adjustTimeStep  no;

maxCo           1;

maxAlphaCo      0.2;

maxDeltaT       1;

// ************************************************************************* //
