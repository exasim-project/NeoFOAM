FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
        p
        {
            solver PCG;
            preconditioner diagonal;
            tolerance 0;
            relTol 1e-2;
        }

        pFinal
        {
                $p;
        }

        Phi
        {
                $p;
        }

	U
        {
            solver PBiCGStab;
            preconditioner diagonal;
            tolerance 0;
            relTol 1e-10;
        }
        
	UFinal
        {
                $U;
        }

	nuTilda
        {
            solver PBiCGStab;
            preconditioner diagonal;
            tolerance 0;
            relTol 1e-10;
        }
        
	nuTildaFinal
        {
                $nuTilda;
        }
}

PISO
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
}


