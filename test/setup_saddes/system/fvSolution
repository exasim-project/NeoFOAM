FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
        p
        {
                solver Ginkgo;
                configFile config.bj.json;
        }

        pFinal
        {
                $p;
        }

        Phi
        {
                $p;
        }

	U
        {
            solver PBiCGStab;
            preconditioner diagonal;
            tolerance 0;
            relTol 1e-10;
        }
        nfU
        {
                solver Ginkgo;
                configFile config.bicgstab.json;
        }

        UFinal
        {
                $U;
        }

	nuTilda
        {
            solver PBiCGStab;
            preconditioner diagonal;
            tolerance 0;
            relTol 1e-10;
        }
        nfNuTilda
        {
                solver Ginkgo;
                configFile config.bicgstab.json;
        }
        nuTildaFinal
        {
                $nuTilda;
        }  
