        <type>void</type>
        <definition>void NeoFOAM::Forces::computePatchForces</definition>
        <argsstring>(int patchi, const NeoN::finiteVolume::cellCentred::VolumeField&lt; NeoN::scalar &gt; &amp;nfP, NeoN::scalar rhoRef, NeoN::scalar pRef, const NeoN::Vec3 &amp;cofR, ForceResult &amp;result) const</argsstring>
        <name>computePatchForces</name>
        <qualifiedname>NeoFOAM::Forces::computePatchForces</qualifiedname>
        <param>
          <type>int</type>
          <declname>patchi</declname>
        </param>
